# =========================
# API-Gateway Authentication
# =========================

GATEWAY_AUTH_USERNAME=gateway
GATEWAY_AUTH_PASSWORD=changeme_local_dev_only

# JWT secret MUST be at least 32 characters (256 bits) for HS256.
# Generate a strong one, e.g.:
#   openssl rand -base64 32
#   openssl rand -hex 32
GATEWAY_JWT_SECRET=your_generated_32_character_string_here_CHANGE_ME
GATEWAY_JWT_EXPIRATION_MINUTES=60