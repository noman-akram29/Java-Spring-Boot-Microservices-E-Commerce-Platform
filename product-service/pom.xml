<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.techie.microservices</groupId>
        <artifactId>ecommerce-dependency-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <!-- Service Naming Convention: product-service (Group: com.techie.microservices, Artifact: product-service) -->
    <groupId>com.techie.microservices</groupId>
    <artifactId>product-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>product-service</name>
    <description>Product Service</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>11.0.25</tomcat.version>
        <!-- Upgraded Jackson version to patch vulnerabilities -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.38</lombok.version>
    </properties>
    <dependencies>
        <!-- Dependency Naming Convention: spring-boot-starter-data-mongodb (Group: org.springframework.boot, Artifact: spring-boot-starter-data-mongodb) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <!-- Dependency Naming Convention: spring-boot-starter-web (Group: org.springframework.boot, Artifact: spring-boot-starter-web) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Dependency Naming Convention: lombok (Group: org.projectlombok, Artifact: lombok) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Dependency Naming Convention: springdoc-openapi-starter-webmvc-ui (Group: org.springdoc, Artifact: springdoc-openapi-starter-webmvc-ui) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.13</version>
        </dependency>

        <!-- Prometheus: micrometer-registry-prometheus (Group: io.micrometer, Artifact: micrometer-registry-prometheus) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Dependency Naming Convention: spring-boot-starter-actuator (Group: org.springframework.boot, Artifact: spring-boot-starter-actuator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Dependency Naming Convention: spring-boot-starter-test (Group: org.springframework.boot, Artifact: spring-boot-starter-test) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dependency Naming Convention: spring-boot-testcontainers (Group: org.springframework.boot, Artifact: spring-boot-testcontainers) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dependency Naming Convention: junit-jupiter (Group: org.testcontainers, Artifact: junit-jupiter) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dependency Naming Convention: mongodb (Group: org.testcontainers, Artifact: mongodb) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dependency Naming Convention: rest-assured (Group: io.rest-assured, Artifact: rest-assured) -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.3.2</version>
        </dependency>

        <!-- Bouncy Castle: bcprov-jdk18on (Group: org.bouncycastle, Artifact: bcprov-jdk18on) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>

        <!-- Dependency Naming Convention: spring-cloud-starter-openfeign (Group: org.springframework.cloud, Artifact: spring-cloud-starter-openfeign) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Dependency Naming Convention: spring-boot-starter-validation (Group: org.springframework.boot, Artifact: spring-boot-starter-validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

    </dependencies>


    <build>
        <plugins>
            <!-- Plugin Convention: maven-compiler-plugin (Group: org.apache.maven.plugins, Artifact: maven-compiler-plugin) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Plugin Convention: spring-boot-maven-plugin (Group: org.springframework.boot, Artifact: spring-boot-maven-plugin) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>