<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.techie.microservices</groupId>
        <artifactId>ecommerce-dependency-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Service Naming Convention: api-gateway (Group: com.techie.microservices, Artifact: api-gateway) -->
    <groupId>com.techie.microservices</groupId>
    <artifactId>api-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api-gateway</name>
    <description>API Gateway</description>

    <properties>
        <!-- <netty.version>4.1.137.Final</netty.version> -->
        <!-- Bump Jackson version to a secure patched release -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- Spring Cloud Gateway (WebFlux): spring-cloud-starter-gateway-server-webflux (Group: org.springframework.cloud, Artifact: spring-cloud-starter-gateway-server-webflux) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- Swagger/OpenAPI for WebFlux Gateway: springdoc-openapi-starter-webflux-ui (Group: org.springdoc, Artifact: springdoc-openapi-starter-webflux-ui) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>2.8.13</version>
        </dependency>

        <!-- Actuator: spring-boot-starter-actuator (Group: org.springframework.boot, Artifact: spring-boot-starter-actuator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Security (WebFlux): spring-boot-starter-security (Group: org.springframework.boot, Artifact: spring-boot-starter-security) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- OAuth2 Resource Server: spring-boot-starter-oauth2-resource-server (Group: org.springframework.boot, Artifact: spring-boot-starter-oauth2-resource-server) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- JJWT Libraries: jjwt-api (Group: io.jsonwebtoken, Artifact: jjwt-api) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>

        <!-- Bouncy Castle: bcprov-jdk18on (Group: org.bouncycastle, Artifact: bcprov-jdk18on) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>

        <!-- Dependency Naming Convention: jjwt-impl (Group: io.jsonwebtoken, Artifact: jjwt-impl) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Dependency Naming Convention: jjwt-jackson (Group: io.jsonwebtoken, Artifact: jjwt-jackson) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Prometheus: micrometer-registry-prometheus (Group: io.micrometer, Artifact: micrometer-registry-prometheus) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Testing: spring-boot-starter-test (Group: org.springframework.boot, Artifact: spring-boot-starter-test) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webtestclient</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <build>
        <plugins>

            <!-- Plugin Convention: spring-boot-maven-plugin (Group: org.springframework.boot, Artifact: spring-boot-maven-plugin) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Plugin Convention: maven-surefire-plugin (Group: org.apache.maven.plugins, Artifact: maven-surefire-plugin) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>