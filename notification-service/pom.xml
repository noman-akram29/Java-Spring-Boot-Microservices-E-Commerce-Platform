<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.techie.microservices</groupId>
        <artifactId>ecommerce-dependency-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <!-- Service Naming Convention: notification-service (Group: com.techie.microservices, Artifact: notification-service) -->
    <groupId>com.techie.microservices</groupId>
    <artifactId>notification-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>notification-service</name>
    <description>Notification Service</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>11.0.25</tomcat.version>
        <!-- Upgraded Jackson version to patch vulnerabilities -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <!-- Dependency Naming Convention: spring-boot-starter-mail (Group: org.springframework.boot, Artifact: spring-boot-starter-mail) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Dependency Naming Convention: spring-boot-starter-web (Group: org.springframework.boot, Artifact: spring-boot-starter-web) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Dependency Naming Convention: spring-kafka (Group: org.springframework.kafka, Artifact: spring-kafka) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Dependency Naming Convention: spring-boot-starter-actuator (Group: org.springframework.boot, Artifact: spring-boot-starter-actuator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Dependency Naming Convention: lombok (Group: org.projectlombok, Artifact: lombok) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Prometheus: micrometer-registry-prometheus (Group: io.micrometer, Artifact: micrometer-registry-prometheus) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Dependency Naming Convention: spring-boot-starter-test (Group: org.springframework.boot, Artifact: spring-boot-starter-test) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Bouncy Castle: bcprov-jdk18on (Group: org.bouncycastle, Artifact: bcprov-jdk18on) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>

        <!-- Dependency Naming Convention: spring-boot-testcontainers (Group: org.springframework.boot, Artifact: spring-boot-testcontainers) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dependency Naming Convention: spring-kafka-test (Group: org.springframework.kafka, Artifact: spring-kafka-test) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dependency Naming Convention: junit-jupiter (Group: org.testcontainers, Artifact: junit-jupiter) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dependency Naming Convention: kafka (Group: org.testcontainers, Artifact: kafka) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dependency Naming Convention: springdoc-openapi-starter-webmvc-ui (Group: org.springdoc, Artifact: springdoc-openapi-starter-webmvc-ui) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.13</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>at.yawk.lz4</groupId>
            <artifactId>lz4-java</artifactId>
            <version>1.11.4</version>
        </dependency>

    </dependencies>


    <build>
        <plugins>

            <!-- Plugin Convention: maven-compiler-plugin (Group: org.apache.maven.plugins, Artifact: maven-compiler-plugin) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Plugin Convention: spring-boot-maven-plugin (Group: org.springframework.boot, Artifact: spring-boot-maven-plugin) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>